  "phases": [
    {
      "id": "phase-1",
      "name": "El dueño del espectáculo",
      "subtitle": "Sentado, burlón y medio dormido",
      "color": "#d9b568",
      "default": "seated",
      "description": "Ordena a sus secuaces desde el asiento. Puede burlarse o dormirse; al caer sus ayudantes se pone serio, se levanta y prepara el ADN.",
      "rules": {
        "damageable": false,
        "nextPhaseCondition": "helpers-defeated",
        "tapedDNAActive": false
      }
    },
    {
      "id": "phase-2",
      "name": "El truco de Fantasmático",
      "subtitle": "ADN pegado al sombrero con cinta",
      "color": "#9ae6cd",
      "default": "idle",
      "description": "Se hunde, aparece con bombas, lanza cuchillos y embiste en triciclo. La desaparición completa y la intangibilidad tienen ventanas propias.",
      "rules": {
        "ghostfreakDNA": true,
        "tapeVisible": true,
        "nextPhaseCondition": "health-threshold",
        "canBecomeInvisible": true,
        "canBecomeIntangible": true
      }
    },
    {
      "id": "phase-3",
      "name": "El último número",
      "subtitle": "Enfurecido, rápido y espectral",
      "color": "#d6a7ed",
      "default": "rage-idle",
      "description": "Sale del suelo, por grietas laterales y desde arriba. Protege la caja con intangibilidad y bombas; al romperla vuelve a ser vulnerable.",
      "rules": {
        "moreAggressive": true,
        "faster": true,
        "surpriseBox": {
          "destructible": true,
          "hasHealth": true,
          "hasCountdown": true,
          "bossIntangibleWhileExists": true,
          "bossThrowsBombsDuringCountdown": true,
          "destroyedEndsInvulnerability": true,
          "cooldownAfterDestroyed": true,
          "timeoutCausesLargeDamage": true
        },
        "reward": "ghostfreak-dna",
        "rewardCondition": "complete-defeat-animation",
        "inheritsPhase2Animations": [
          "sink",
          "ground-bomb",
          "vanish",
          "reappear",
          "mount",
          "tricycle"
        ],
        "rewardAfterDefeatAnimation": "ghostfreak-dna"
      }
    }
